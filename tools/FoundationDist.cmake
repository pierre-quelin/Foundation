# dist/<target>/ layout — BUILD_TARGET from env, else inferred from toolchain.
# FOUNDATION_SRC_ROOT: when Foundation is add_subdirectory'd under Sample.
if(NOT DEFINED FOUNDATION_SRC_ROOT)
    set(FOUNDATION_SRC_ROOT "${CMAKE_SOURCE_DIR}")
endif()

if(DEFINED ENV{BUILD_TARGET} AND NOT "$ENV{BUILD_TARGET}" STREQUAL "")
    set(FOUNDATION_DIST_TARGET "$ENV{BUILD_TARGET}")
elseif(CMAKE_TOOLCHAIN_FILE MATCHES "mingw64")
    set(FOUNDATION_DIST_TARGET "mingw64")
elseif(WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    set(FOUNDATION_DIST_TARGET "mingw64")
elseif(MSVC)
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(FOUNDATION_DIST_TARGET "msvc${MSVC_VERSION}-x86_64")
    else()
        set(FOUNDATION_DIST_TARGET "msvc${MSVC_VERSION}-x86")
    endif()
elseif(UNIX AND NOT APPLE)
    set(FOUNDATION_DIST_TARGET "linux-x86_64-unknown")
else()
    set(FOUNDATION_DIST_TARGET "unknown")
endif()

set(FOUNDATION_DIST_ROOT "${FOUNDATION_SRC_ROOT}/dist/${FOUNDATION_DIST_TARGET}")
message(STATUS "FOUNDATION_DIST_TARGET: ${FOUNDATION_DIST_TARGET}")
message(STATUS "FOUNDATION_DIST_ROOT: ${FOUNDATION_DIST_ROOT}")
