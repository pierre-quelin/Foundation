# Arduino Esplora PoC HID (LUFA) — VID/PID from libesplora_hid / Esplora-firmware
# Install: sudo cp 99-esplora-hid.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules && sudo udevadm trigger
# Re-plug the device; ensure your user is in group plugdev (then re-login).
SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="e5f1", MODE="0666", GROUP="plugdev"
